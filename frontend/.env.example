# Required in Vercel and local frontend environments.
# Use the deployed FastAPI backend URL, not the Streamlit frontend URL.
NEXT_PUBLIC_API_BASE_URL=https://YOUR_BACKEND_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Keep false in public/client-facing deployments. The debug panel is hidden in
# production unless this is explicitly set to true.
NEXT_PUBLIC_INTERNAL_DEBUG=false
