# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# Base URL for the Programa web app
PROGRAMA_URL=https://app.programa.design/

# Path to the persistent Chrome profile directory.
# Session cookies are stored here so Programa stays logged in between runs.
PROGRAMA_BROWSER_PROFILE=data/browser_profiles/programa_assistant

# Anthropic API key — required for AI-assisted PDF extraction.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# Vendor AI calls are disabled by default. Set true only after configuring a provider.
VENDOR_CALLS_ENABLED=false
VENDOR_CALL_MOCK_MODE=false
VENDOR_CALL_PROVIDER=retell
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_PHONE_NUMBER=
BLAND_PROVIDER=bland
BLAND_API_KEY=
BLAND_PHONE_NUMBER=
BLAND_USE_CALLER_NUMBER=true
BLAND_MINIMAL_PAYLOAD=true
BLAND_AGENT_NAME=Alley
BLAND_PERSONA_ID=
BLAND_VOICE=
BLAND_VOICE_ID=
BLAND_USE_VOICE_OVERRIDE=false
BLAND_USE_PATHWAY=false
BLAND_PATHWAY_ID=
BLAND_MAX_DURATION_MINUTES=10
VENDOR_CALL_TEST_PHONE=

# Production frontend -> backend connection.
# Vercel should set this to the deployed FastAPI base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
