# Copy this file to .env for private local development.
# Never commit real credentials, cookies, browser profiles, logs, or uploaded files.

# Public-demo safety defaults. Real integrations are disabled unless both values
# are deliberately changed in a private environment.
DEMO_MODE=true
ENABLE_REAL_INTEGRATIONS=false

# Programa browser automation (private local use only)
PROGRAMA_URL=https://app.programa.design/
PROGRAMA_BROWSER_PROFILE=data/browser_profiles/local_only

# AI/enrichment providers (private local use only)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
BRAVE_API_KEY=your_brave_api_key_here

# Public image hosting for Photo Inventory Upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Or use CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Vendor calls are disabled in the public demo by default.
VENDOR_CALLS_ENABLED=false
VENDOR_CALL_MOCK_MODE=true
VENDOR_CALL_PROVIDER=disabled
VENDOR_CALL_ALLOW_FALLBACK=false
VENDOR_CALL_TEST_PHONE=+10000000000

# Retell (private local use only)
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_PHONE_NUMBER=+10000000000

# Bland legacy fallback (private local use only)
BLAND_PROVIDER=bland
BLAND_API_KEY=your_bland_api_key_here
BLAND_PHONE_NUMBER=+10000000000
BLAND_AGENT_NAME=your_agent_name_here
BLAND_PERSONA_ID=your_persona_id_here
BLAND_VOICE=your_voice_name_here
BLAND_VOICE_ID=your_voice_id_here
BLAND_PATHWAY_ID=your_pathway_id_here
BLAND_USE_CALLER_NUMBER=false
BLAND_MINIMAL_PAYLOAD=true
BLAND_USE_VOICE_OVERRIDE=false
BLAND_USE_PATHWAY=false
BLAND_MAX_DURATION_MINUTES=10

# Frontend -> backend connection. NEXT_PUBLIC values are visible in the browser;
# never put secrets in NEXT_PUBLIC_* variables. In Vercel, set this to the
# deployed FastAPI backend URL, not the Streamlit frontend URL.
NEXT_PUBLIC_API_BASE_URL=https://YOUR_BACKEND_URL
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
