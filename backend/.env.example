# Backend-only example values. Keep real secrets in a private .env file.

DEMO_MODE=true
ENABLE_REAL_INTEGRATIONS=false

PROGRAMA_URL=https://app.programa.design/
PROGRAMA_BROWSER_PROFILE=/tmp/sch-data/browser_profiles/local_only

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_FURTHER_ENRICHMENT_MODEL=gpt-4o-mini
OPENAI_FURTHER_INPUT_COST_PER_1K=0.00015
OPENAI_FURTHER_OUTPUT_COST_PER_1K=0.00060
OPENAI_FURTHER_MAX_OUTPUT_TOKENS=2200
OPENAI_FURTHER_TIMEOUT_SECONDS=60
BRAVE_API_KEY=your_brave_api_key_here

# Durable enrichment memory / source registry.
# Apply ../supabase/migrations/20260601_product_source_memory.sql first.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SOURCE_MEMORY_ENABLED=true

VENDOR_CALLS_ENABLED=false
VENDOR_CALL_MOCK_MODE=true
VENDOR_CALL_PROVIDER=disabled
VENDOR_CALL_ALLOW_FALLBACK=false
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_PHONE_NUMBER=+10000000000

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
