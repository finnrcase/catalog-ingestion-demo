# Backend-only example values. Keep real secrets in a private .env file.

DEMO_MODE=true
ENABLE_REAL_INTEGRATIONS=false

PROGRAMA_URL=https://app.programa.design/
PROGRAMA_BROWSER_PROFILE=data/browser_profiles/local_only

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
BRAVE_MAX_SEARCHES_PER_PRODUCT=1
ENRICHMENT_CACHE_ENABLED=true
ENRICHMENT_MAX_URLS_PER_PRODUCT=5
ENRICHMENT_MAX_AI_CALLS_PER_PRODUCT=0

ENRICHMENT_TARGET_BUDGET_USD=0.10
ENRICHMENT_HARD_BUDGET_USD=0.25
ENRICHMENT_MAX_AI_CALLS_PER_UPLOAD=1
ENRICHMENT_MAX_EXTERNAL_LOOKUPS_PER_UPLOAD=12
ENRICHMENT_MAX_IMAGE_SEARCHES_PER_UPLOAD=3
ENRICHMENT_MAX_RETRIES_PER_UPLOAD=3
ENRICHMENT_SEARCH_COST_USD=0.003
ENRICHMENT_FETCH_COST_USD=0.0005
ENRICHMENT_AI_CALL_COST_USD=0.03
ENRICHMENT_IMAGE_SEARCH_COST_USD=0.003
ALLOW_ADMIN_ENRICHMENT_MODES=false
SOURCE_SUCCESS_REGISTRY_PATH=data/source_success_registry.json
ENRICHMENT_COST_HISTORY_PATH=data/enrichment_cost_history.json
PREFERRED_WEBSITES_PATH=data/preferred_product_websites.json

ENVIRONMENT=development
MAX_UPLOAD_BYTES=104857600
PDF_PARSE_WORKERS=2
SCH_TMP_UPLOAD_ROOT=.tmp/uploads

UPLOAD_STORAGE_PROVIDER=local
REQUIRE_PERSISTENT_UPLOAD_STORAGE=false
UPLOAD_STORAGE_PREFIX=sch-intake
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=sch-intake-uploads
SUPABASE_STORAGE_PUBLIC_BASE_URL=

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_UPLOAD_FOLDER=sch-designops/product-images
CLOUDINARY_URL=

VENDOR_CALLS_ENABLED=false
VENDOR_CALL_MOCK_MODE=true
VENDOR_CALL_PROVIDER=disabled
VENDOR_CALL_ALLOW_FALLBACK=false
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here
RETELL_PHONE_NUMBER=+10000000000
BLAND_AUTH_HEADER_NAME=Authorization

FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
